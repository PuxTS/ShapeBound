  m_Script: {fileID: 11500000, guid: fb1e163726c5acd4d8714162c4269516, type: 3}
  m_Name: TutorialNPC - Z2.1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  npcLines:
  - "Now that you\u2019re out of the cave, I\u2019ve taught you everything I can. Here is my final gift before you begin scaling the exterior peaks."
  - Take the Spike form. Throwing yourself against walls in this form lets you stick to surfaces to save a bad fall but remember, it only has two charges before you must land on solid ground again!
  - Everything is in order now. Goodbye, stay focused, and good luck on your journey to the summit!
  signLines:
  - 'Press "3" to switch to Spike Form. Sticking to wall has 2 charges. '
  givesFormReward: 1
  formToUnlock: 3
  switchToFormOnUnlock: 0
  revealZoneName: Zone 2.1
  hideZoneName: Zone 2.2
